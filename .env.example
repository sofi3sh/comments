APP_NAME=Comments
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://platform.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myproject
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# config/octane.php defaults this to roadrunner, which is not what we run.
# Must be set explicitly or octane:reload targets the wrong server type.
OCTANE_SERVER=frankenphp

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# search
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

VITE_DEV_SERVER_URL=http://vite:5173

# ── Static mode object storage (MinIO locally, Hetzner S3 in staging/prod)
STATIC_S3_ENDPOINT=http://minio:9000
STATIC_S3_KEY=minioadmin
STATIC_S3_SECRET=minioadmin
STATIC_S3_REGION=us-east-1
STATIC_S3_PATH_STYLE=true
STATIC_PUBLIC_BUCKET=static-public
STATIC_PRIVATE_BUCKET=static-private

# Browser-facing nginx host for private fragments — NOT the S3 endpoint.
STATIC_PRIVATE_URL=https://content-7f000001.nip.io

# ── User uploads (attachments, avatars, site logos, locale icons)
# The `public` disk. Same object store as above — set UPLOADS_S3_ENDPOINT /
# _KEY / _SECRET / _REGION / _PATH_STYLE only to split it onto its own account.
# Must match UPLOADS_BUCKET in the root .env (nginx + bucket provisioning).
UPLOADS_BUCKET=uploads
# Browser-facing nginx origin that proxies /storage/{key} into the bucket —
# NOT the S3 endpoint. Defaults to APP_URL.'/storage'.
#UPLOADS_URL=

# Backpack's cached admin assets stay on the container filesystem. Basset feeds
# $disk->path() straight to File::put(); on an S3 disk that is a bare object key,
# so the writes silently land somewhere nothing serves. Never point this at
# `public` — see config/filesystems.php.
BASSET_DISK=basset
## should be > 0
STATIC_MANUAL_INVALIDATION_DELETE_BATCH_SIZE=1000

#STATIC_RESTRICT_MODE=
#TEST_LOG_INFO=

#####  TRANSLATE PROVIDERS
## google
ARTICLE_TRANSLATION_PROVIDER=google
ARTICLE_TRANSLATION_MAX_SYNC_CHARACTERS=30000
GOOGLE_TRANSLATE_API_KEY=


###### CONTENT UNUQUE PROVIDERS
###   content-watch.ru
ARTICLE_CONTENT_UNIQUENESS_LOCALES=uk,ru
ARTICLE_CONTENT_UNIQUENESS_BATCH_SIZE=5
ARTICLE_CONTENT_UNIQUENESS_CRON="*/10 * * * *"
CONTENT_WATCH_API_KEY=
CONTENT_WATCH_ENDPOINT=https://content-watch.ru/public/api/

###### STATIC ########
STATIC_CAPTURE_ENABLED=

### GOOGLE_NEWS_COMMENTS_URL
GOOGLE_NEWS_COMMENTS_URL=https://news.google.com/publications/CAAiEJyqHZB4rffCKRtEBRWUCeMqFAgKIhCcqh2QeK33wikbRAUVlAnj?hl=ru&gl=UA&ceid=UA%3Aru