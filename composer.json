{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-redis": "*",
        "ext-zlib": "*",
        "astrotomic/laravel-translatable": "^11.16",
        "backpack/crud": "^6.8",
        "backpack/pro": "^2.2",
        "backpack/theme-coreuiv2": "^1.2",
        "backpack/theme-tabler": "^1.2",
        "bumpcore/editor.php": "1.x-dev",
        "darkaonline/l5-swagger": "^9.0",
        "kalnoy/nestedset": "^6.0",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.18",
        "laravel/scout": "^11.1",
        "laravel/socialite": "^5.25",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "meilisearch/meilisearch-php": "^1.16",
        "owen-it/laravel-auditing": "^14.0",
        "spatie/laravel-permission": "^6.23",
        "spatie/schema-org": "^4.0"
    },
    "require-dev": {
        "backpack/generators": "^4.0",
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.7",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/larastan": "^3.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "psalm/plugin-laravel": "^3.0",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "psalm": "php -d auto_prepend_file=psalm-stubs/backpack-pro.php ./vendor/bin/psalm",
        "phpstan": "vendor/bin/phpstan analyse app --memory-limit 1G",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-install-cmd": ["@php artisan storage:link --quiet"]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "backpack/crud",
                "backpack/pro"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.backpackforlaravel.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/yarkm13/editor.php"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
