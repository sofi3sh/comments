# Build context exclusions.
#
# Both images run `COPY . .`, so anything not excluded here is baked into the
# layer. vendor/ and public/build are rebuilt inside the image on purpose —
# copying the host's copies would ship whatever happened to be on a developer's
# machine, including dev-only Composer packages.

.git
.gitlab-ci.yml
.idea
.vscode
.DS_Store

# Installed inside the image by the vendor / frontend stages.
vendor
node_modules
public/build
public/hot
public/storage
public/frankenphp-worker.php

# Never bake environment or secrets into an image.
.env
.env.*
!.env.example
docker/composer-auth.json

# Local-only state.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
.phpunit.result.cache
.phpunit.cache

# Dev tooling that has no place in a production image.
tests
psalm.xml
psalm-stubs
phpunit.xml
boost.json
